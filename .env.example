# Copia este archivo como .env y llena los valores

# PostgreSQL — Railway lo genera automáticamente
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Clave secreta para firmar cookies de sesión — genera con: openssl rand -hex 32
SESSION_SECRET="cambia_esto_por_una_clave_aleatoria_larga_64_caracteres_hex"

# Clave para cifrar credenciales de Google/Apple Wallet en la base de datos — genera con: openssl rand -hex 32
WALLET_SECRETS_KEY="cambia_esto_por_una_clave_aleatoria_larga_64_caracteres_hex"
