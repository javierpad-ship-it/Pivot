// SQLite schema for local development only
// Production uses schema.prisma (PostgreSQL) with migration files

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Empresa {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  stores    Store[]
}

model Zona {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  stores    Store[]
  usuarios  Usuario[]
}

model Genero {
  id              String           @id @default(cuid())
  name            String           @unique
  createdAt       DateTime         @default(now())

  programaciones  Programacion[]
  conteoRegistros ConteoRegistro[]
}

model Store {
  id              String               @id @default(cuid())
  name            String
  distrito        String
  ciudad          String
  empresaId       String?
  zonaId          String?
  createdAt       DateTime             @default(now())

  empresa         Empresa?             @relation(fields: [empresaId], references: [id])
  zona            Zona?                @relation(fields: [zonaId], references: [id])
  countTasks      CountTask[]
  systemStocks    SystemStock[]
  programacionTiendas ProgramacionTienda[]
  conteoRegistros ConteoRegistro[]
  usuarios        Usuario[]
}

model Brand {
  id              String           @id @default(cuid())
  name            String           @unique

  countTasks      CountTask[]
  systemStocks    SystemStock[]
  programaciones  Programacion[]
  conteoRegistros ConteoRegistro[]
}

model Mundo {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  lineas    Linea[]
}

model Linea {
  id              String           @id @default(cuid())
  name            String
  mundoId         String
  createdAt       DateTime         @default(now())

  mundo           Mundo            @relation(fields: [mundoId], references: [id])
  countTasks      CountTask[]
  systemStocks    SystemStock[]
  programaciones  Programacion[]
  conteoRegistros ConteoRegistro[]

  @@unique([name, mundoId])
}

model CountTask {
  id          String      @id @default(cuid())
  storeId     String
  brandId     String
  lineaId     String
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  store       Store       @relation(fields: [storeId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  linea       Linea       @relation(fields: [lineaId], references: [id])
  countRecord CountRecord?

  @@unique([storeId, brandId, lineaId])
}

model CountRecord {
  id           String    @id @default(cuid())
  taskId       String    @unique
  quantity     Int
  employeeName String
  countedAt    DateTime  @default(now())

  task         CountTask @relation(fields: [taskId], references: [id])
}

model SystemStock {
  id             String   @id @default(cuid())
  storeId        String
  brandId        String
  lineaId        String
  systemQuantity Int
  updatedAt      DateTime @updatedAt

  store          Store    @relation(fields: [storeId], references: [id])
  brand          Brand    @relation(fields: [brandId], references: [id])
  linea          Linea    @relation(fields: [lineaId], references: [id])

  @@unique([storeId, brandId, lineaId])
}

// --- SISTEMA DE PROGRAMACIÓN SEMANAL ---

model Programacion {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves
  scope     String   @default("ALL") // "ALL" = todas las tiendas, "SOME" = tiendas específicas
  brandId   String
  lineaId   String
  generoId  String
  createdAt DateTime @default(now())

  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  linea     Linea    @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  genero    Genero   @relation(fields: [generoId], references: [id], onDelete: Cascade)
  tiendas   ProgramacionTienda[]

  @@unique([dayOfWeek, brandId, lineaId, generoId])
}

model ProgramacionTienda {
  id             String       @id @default(cuid())
  programacionId String
  storeId        String

  programacion   Programacion @relation(fields: [programacionId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([programacionId, storeId])
}

model ConteoRegistro {
  id        String   @id @default(cuid())
  storeId   String
  brandId   String
  lineaId   String
  generoId  String
  fecha     DateTime // SQLite: no @db.Date needed
  cantidad  Int
  empleado  String
  creadoEn  DateTime @default(now())

  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  linea     Linea   @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  genero    Genero  @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@unique([storeId, brandId, lineaId, generoId, fecha])
}

model ConfigDia {
  dayOfWeek Int     @id  // 1=Lunes … 7=Domingo
  name      String
  enabled   Boolean @default(false)
}

// Roles: SUPER_ADMIN | ADMIN | PROGRAMADOR | GERENTE_ZONAL | TIENDA
model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  username  String   @unique
  password  String
  rol       String
  activo    Boolean  @default(true)
  storeId   String?
  zonaId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  zona      Zona?    @relation(fields: [zonaId], references: [id], onDelete: SetNull)
}
