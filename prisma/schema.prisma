generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  stores    Store[]
}

model Zona {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  stores    Store[]
}

model Store {
  id           String        @id @default(cuid())
  name         String
  location     String
  empresaId    String?
  zonaId       String?
  createdAt    DateTime      @default(now())

  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  zona         Zona?         @relation(fields: [zonaId], references: [id])
  countTasks   CountTask[]
  systemStocks SystemStock[]
}

model Brand {
  id           String        @id @default(cuid())
  name         String        @unique

  countTasks   CountTask[]
  systemStocks SystemStock[]
}

model Mundo {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  lineas    Linea[]
}

model Linea {
  id           String        @id @default(cuid())
  name         String
  mundoId      String
  createdAt    DateTime      @default(now())

  mundo        Mundo         @relation(fields: [mundoId], references: [id])
  countTasks   CountTask[]
  systemStocks SystemStock[]

  @@unique([name, mundoId])
}

model CountTask {
  id          String      @id @default(cuid())
  storeId     String
  brandId     String
  lineaId     String
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  store       Store       @relation(fields: [storeId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  linea       Linea       @relation(fields: [lineaId], references: [id])
  countRecord CountRecord?

  @@unique([storeId, brandId, lineaId])
}

model CountRecord {
  id           String    @id @default(cuid())
  taskId       String    @unique
  quantity     Int
  employeeName String
  countedAt    DateTime  @default(now())

  task         CountTask @relation(fields: [taskId], references: [id])
}

model SystemStock {
  id             String   @id @default(cuid())
  storeId        String
  brandId        String
  lineaId        String
  systemQuantity Int
  updatedAt      DateTime @updatedAt

  store          Store    @relation(fields: [storeId], references: [id])
  brand          Brand    @relation(fields: [brandId], references: [id])
  linea          Linea    @relation(fields: [lineaId], references: [id])

  @@unique([storeId, brandId, lineaId])
}
