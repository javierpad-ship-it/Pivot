generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  stores Store[]
}

model Zona {
  id                    String   @id @default(cuid())
  name                  String   @unique
  responsableZonaId     String?
  supervisorAprobadorId String?
  createdAt             DateTime @default(now())

  stores                 Store[]
  usuarios               Usuario[]
  programacionesDescanso ProgramacionDescanso[]
}

model Genero {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  programaciones  Programacion[]
  conteoRegistros ConteoRegistro[]
}

model Store {
  id                      String   @id @default(cuid())
  name                    String
  distrito                String
  ciudad                  String
  direccion               String?
  latitud                 Float? // para ubicaciones en pases de Google/Apple Wallet
  longitud                Float?
  empresaId               String?
  zonaId                  String?
  formatoDireccion        String? // "FORMATO_1" | "FORMATO_2"
  gerenteTitularId        String?
  jefeTurnoTitularId      String?
  cantSupervisoresTesoros Int      @default(1)
  tieneSupervisorAsesoria Boolean  @default(false)
  createdAt               DateTime @default(now())

  empresa             Empresa?             @relation(fields: [empresaId], references: [id])
  zona                Zona?                @relation(fields: [zonaId], references: [id])
  gerenteTitular      Persona?             @relation("GerenteTitular", fields: [gerenteTitularId], references: [id], onDelete: SetNull)
  jefeTurnoTitular    Persona?             @relation("JefeTurnoTitular", fields: [jefeTurnoTitularId], references: [id], onDelete: SetNull)
  countTasks          CountTask[]
  systemStocks        SystemStock[]
  programacionTiendas ProgramacionTienda[]
  conteoRegistros     ConteoRegistro[]
  usuarios            Usuario[]
  personasBase        Persona[]            @relation("PersonaTiendaBase")
  registrosDescanso   RegistroDescanso[]
  cuotasVentas        CuotaVentas[]
  clientesMembresia   MembresiaCliente[]
}

model Brand {
  id   String @id @default(cuid())
  name String @unique

  countTasks      CountTask[]
  systemStocks    SystemStock[]
  programaciones  Programacion[]
  conteoRegistros ConteoRegistro[]
}

model Mundo {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  lineas Linea[]
}

model Linea {
  id        String   @id @default(cuid())
  name      String
  mundoId   String
  createdAt DateTime @default(now())

  mundo           Mundo            @relation(fields: [mundoId], references: [id])
  countTasks      CountTask[]
  systemStocks    SystemStock[]
  programaciones  Programacion[]
  conteoRegistros ConteoRegistro[]

  @@unique([name, mundoId])
}

model CountTask {
  id        String   @id @default(cuid())
  storeId   String
  brandId   String
  lineaId   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store        @relation(fields: [storeId], references: [id])
  brand       Brand        @relation(fields: [brandId], references: [id])
  linea       Linea        @relation(fields: [lineaId], references: [id])
  countRecord CountRecord?

  @@unique([storeId, brandId, lineaId])
}

model CountRecord {
  id           String   @id @default(cuid())
  taskId       String   @unique
  quantity     Int
  employeeName String
  countedAt    DateTime @default(now())

  task CountTask @relation(fields: [taskId], references: [id])
}

model SystemStock {
  id             String   @id @default(cuid())
  storeId        String
  brandId        String
  lineaId        String
  systemQuantity Int
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])
  linea Linea @relation(fields: [lineaId], references: [id])

  @@unique([storeId, brandId, lineaId])
}

// --- SISTEMA DE PROGRAMACIÓN SEMANAL ---

model Programacion {
  id        String   @id @default(cuid())
  dayOfWeek Int // 1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves
  scope     String   @default("ALL") // "ALL" = todas las tiendas, "SOME" = tiendas específicas
  brandId   String
  lineaId   String
  generoId  String
  createdAt DateTime @default(now())

  brand   Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  linea   Linea                @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  genero  Genero               @relation(fields: [generoId], references: [id], onDelete: Cascade)
  tiendas ProgramacionTienda[]

  @@unique([dayOfWeek, brandId, lineaId, generoId])
}

model ProgramacionTienda {
  id             String @id @default(cuid())
  programacionId String
  storeId        String

  programacion Programacion @relation(fields: [programacionId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([programacionId, storeId])
}

model ConteoRegistro {
  id       String   @id @default(cuid())
  storeId  String
  brandId  String
  lineaId  String
  generoId String
  fecha    DateTime @db.Date
  cantidad Int
  empleado String
  creadoEn DateTime @default(now())

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  linea  Linea  @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  genero Genero @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@unique([storeId, brandId, lineaId, generoId, fecha])
}

model ConfigDia {
  dayOfWeek Int     @id // 1=Lunes … 7=Domingo
  name      String
  enabled   Boolean @default(false)
}

// =====================================================
// MÓDULO CUOTAS DE VENTAS
// =====================================================

model CuotaVentas {
  id        String   @id @default(cuid())
  storeId   String
  semana    Int // ISO week number (1-53)
  anio      Int
  monto     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ventas VentaReal[]

  @@unique([storeId, semana, anio])
}

model VentaReal {
  id        String   @id @default(cuid())
  cuotaId   String
  fecha     DateTime @db.Date
  monto     Float
  empleado  String?
  createdAt DateTime @default(now())

  cuota CuotaVentas @relation(fields: [cuotaId], references: [id], onDelete: Cascade)
}

// Roles: SUPER_ADMIN | ADMIN | PROGRAMADOR | GERENTE_ZONAL | TIENDA
model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  username  String   @unique
  password  String
  rol       String
  activo    Boolean  @default(true)
  storeId   String?
  zonaId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  zona  Zona?  @relation(fields: [zonaId], references: [id], onDelete: SetNull)

  programacionesCreadaPor   ProgramacionDescanso[] @relation("ProgramacionCreadaPor")
  programacionesAprobadaPor ProgramacionDescanso[] @relation("ProgramacionAprobadaPor")
  auditoriasDescanso        AuditoriaDescanso[]
}

// =====================================================
// MÓDULO DESCANSOS
// =====================================================

model Persona {
  id             String   @id @default(cuid())
  codigo         String   @unique
  nombreCompleto String
  tiendaBaseId   String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tiendaBase           Store?                  @relation("PersonaTiendaBase", fields: [tiendaBaseId], references: [id], onDelete: SetNull)
  roles                RolPersona[]
  elegibilidades       ElegibilidadCobertura[]
  descansos            RegistroDescanso[]      @relation("PersonaDescanso")
  coberturas           RegistroDescanso[]      @relation("PersonaCobertura")
  tiendaGerenteTitular Store[]                 @relation("GerenteTitular")
  tiendaJefeTurno      Store[]                 @relation("JefeTurnoTitular")
}

model RolPersona {
  id        String @id @default(cuid())
  personaId String
  rol       String // RolPersonal enum values

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, rol])
}

model ElegibilidadCobertura {
  id          String @id @default(cuid())
  personaId   String
  rolHabilita String // RolPersonal enum values

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, rolHabilita])
}

model ProgramacionDescanso {
  id            String    @id @default(cuid())
  zonaId        String
  periodoInicio DateTime  @db.Date
  periodoFin    DateTime  @db.Date
  estado        String    @default("BORRADOR") // BORRADOR | PENDIENTE_APROBACION | APROBADO | RECHAZADO
  motivoRechazo String?
  creadoPorId   String
  aprobadoPorId String?
  aprobadoEn    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  zona        Zona                @relation(fields: [zonaId], references: [id])
  creadoPor   Usuario             @relation("ProgramacionCreadaPor", fields: [creadoPorId], references: [id])
  aprobadoPor Usuario?            @relation("ProgramacionAprobadaPor", fields: [aprobadoPorId], references: [id])
  registros   RegistroDescanso[]
  auditoria   AuditoriaDescanso[]
}

model RegistroDescanso {
  id                   String   @id @default(cuid())
  programacionId       String
  storeId              String
  personaId            String
  cargo                String // RolPersonal
  tipoMovimiento       String // TipoMovimiento
  coberturaId          String?
  observacion          String?
  fecha                DateTime @db.Date
  alertaSabadoAceptada Boolean  @default(false)
  createdAt            DateTime @default(now())

  programacion ProgramacionDescanso @relation(fields: [programacionId], references: [id], onDelete: Cascade)
  store        Store                @relation(fields: [storeId], references: [id])
  persona      Persona              @relation("PersonaDescanso", fields: [personaId], references: [id])
  cobertura    Persona?             @relation("PersonaCobertura", fields: [coberturaId], references: [id])
}

model AuditoriaDescanso {
  id             String   @id @default(cuid())
  programacionId String
  usuarioId      String
  accion         String // CREAR | EDITAR | ENVIAR | APROBAR | RECHAZAR
  valorAnterior  Json?
  valorNuevo     Json?
  fechaHora      DateTime @default(now())

  programacion ProgramacionDescanso @relation(fields: [programacionId], references: [id], onDelete: Cascade)
  usuario      Usuario              @relation(fields: [usuarioId], references: [id])
}

// ─── MEMBRESÍA LK (programa de fidelización de clientes) ───────────────────

model MembresiaCliente {
  id               String   @id @default(cuid())
  nombre           String
  dni              String?  @unique
  telefono         String?
  storeId          String?
  puntos           Int      @default(0) // saldo canjeable actual
  puntosAcumulados Int      @default(0) // total histórico, define el nivel
  nivel            String   @default("BRONCE") // BRONCE | PLATA | ORO | PLATINO
  estampitas       Int      @default(0) // progreso actual hacia el premio (tarjetas tipo ESTAMPITAS)
  premiosCanjeados Int      @default(0) // historial de premios de estampitas ganados
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())

  walletDisenoId  String?
  googleObjectId  String? @unique // ID del Loyalty Object en Google Wallet, una vez emitido
  applePassSerial String? @unique // serialNumber del .pkpass de Apple Wallet, una vez emitido
  portalToken     String  @unique @default(dbgenerated("gen_random_uuid()")) // token del enlace público /mi-tarjeta/[token]

  store        Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  walletDiseno MembresiaDisenoTarjeta? @relation(fields: [walletDisenoId], references: [id], onDelete: SetNull)
  movimientos  MembresiaMovimiento[]
}

model MembresiaMovimiento {
  id          String   @id @default(cuid())
  clienteId   String
  tipo        String // COMPRA | CANJE | AJUSTE | SELLO | PREMIO
  puntos      Int // delta de puntos o de estampitas según el tipo de tarjeta del cliente
  montoCompra Float?
  descripcion String?
  createdAt   DateTime @default(now())

  cliente MembresiaCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// Plantilla de diseño de tarjeta (puntos o estampitas), reutilizable para Google/Apple Wallet
model MembresiaDisenoTarjeta {
  id                String   @id @default(cuid())
  nombre            String // nombre interno del diseño, ej. "Tarjeta VIP Lukers"
  tipo              String // PUNTOS | ESTAMPITAS
  activo            Boolean  @default(false) // el diseño activo por tipo es el usado al emitir tarjetas nuevas
  nombrePrograma    String // nombre visible del programa en la tarjeta
  descripcion       String?
  logoUrl           String?
  heroImageUrl      String?
  colorFondo        String   @default("#1a73e8")
  colorTexto        String   @default("#ffffff")
  totalEstampitas   Int? // solo ESTAMPITAS: cantidad de sellos para ganar el premio
  premioDescripcion String? // solo ESTAMPITAS: qué se gana al completar la tarjeta
  beneficioBronce   String? // solo PUNTOS: beneficio visible al cliente en el nivel Bronce
  beneficioPlata    String? // solo PUNTOS: beneficio visible al cliente en el nivel Plata
  beneficioOro      String? // solo PUNTOS: beneficio visible al cliente en el nivel Oro
  beneficioPlatino  String? // solo PUNTOS: beneficio visible al cliente en el nivel Platino
  googleClassId     String? // se completa al publicar el diseño en Google Wallet
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clientes MembresiaCliente[]
}

// Credenciales de integración con Google/Apple Wallet (registro único, cifrado en reposo)
model MembresiaWalletConfig {
  id                          String   @id @default(cuid())
  googleIssuerId              String?
  googleServiceAccountJsonEnc String? // JSON del service account, cifrado
  appleTeamId                 String?
  applePassTypeId             String?
  appleCertP12Enc             String? // certificado .p12 (base64), cifrado
  appleCertPasswordEnc        String? // contraseña del .p12, cifrada
  updatedAt                   DateTime @updatedAt
}
